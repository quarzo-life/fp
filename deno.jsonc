{
  "name": "@quarzo-life/fp",
  "version": "0.1.1",
  "description": "Pure, dependency-free functional programming helpers for TypeScript - pipe/compose, Result, Either, immutability.",
  "license": "MIT",
  "exports": "./mod.ts",
  "lock": true,
  "nodeModulesDir": "auto",
  // Tests run under vitest (`deno task test`), not Deno's native runner.
  // Keep `deno test` from auto-discovering these vitest files.
  "test": {
    "exclude": ["src/**/*.test.ts"]
  },
  // deno fmt's HTML/XML formatter reindents .github/assets/logo.svg and inserts
  // whitespace text nodes between the <tspan>s, which SVG renders as a visible
  // space between the "f" and "p" glyphs.
  "fmt": {
    "exclude": [".github/assets/logo.svg"]
  },
  "imports": {
    "vitest": "npm:vitest@^4.1.10",
    "mod": "./mod.ts",
    "api/": "./src/api/"
  },
  "tasks": {
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
