{
  "name": "@quarzo-life/fp",
  "version": "0.2.1",
  "description": "Pure, dependency-free functional programming helpers for TypeScript - pipe/compose, Result, Option, immutability.",
  "license": "MIT",
  "exports": "./mod.ts",
  "lock": true,
  "nodeModulesDir": "auto",
  // Tests run under vitest (`deno task test`), not Deno's native runner.
  // Keep `deno test` from auto-discovering these vitest files.
  "test": {
    "exclude": ["src/**/*.test.ts"],
  },
  "imports": {
    "vitest": "npm:vitest@^4.1.10",
    "mod": "./mod.ts",
    "api/": "./src/api/",
  },
  "tasks": {
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    // Format and lint with Oxc (https://oxc.rs), as in the Quarzo Life
    // monorepo. Configuration: .oxfmtrc.jsonc and .oxlintrc.jsonc.
    "format": "deno run -A npm:oxfmt@0.75.0",
    "format:check": "deno run -A npm:oxfmt@0.75.0 --check",
    "lint": "deno run -A npm:oxlint@1.90.0",
  },
}
